--- !u!114 &1207220233
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1207220231}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>[ \uCE74\uD398 \uACBD\uC601 \uB3C4\uC6C0\uB9D0 ]</b>\n\n<b>\u25B6 \uC900\uBE44
    \uB2E8\uACC4</b>\n- \uAC19\uC740 \uC7AC\uB8CC 2\uAC1C\uB97C \uACB9\uCCD0 \uACE0\uAE09
    \uC7AC\uB8CC\uB85C \uBA38\uC9C0\n- \uC624\uB978\uCABD \uBC1C\uC8FC \uD328\uB110\uC5D0\uC11C
    \uC7AC\uB8CC \uAD6C\uB9E4 (\uD558\uB8E8 1\uD68C)\n- \uC0C1\uB2E8 '\uC601\uC5C5
    \uC2DC\uC791'\uC73C\uB85C \uC601\uC5C5 \uC9C4\uC785\n\n<b>\u25B6 \uC601\uC5C5
    \uB2E8\uACC4 (\uC9C1\uC811 \uC81C\uC791)</b>\n- \uC190\uB2D8 \uCE74\uB4DC\uB97C
    \uB20C\uB7EC \uC8FC\uBB38 \uBC1B\uAE30\n- \uC5D0\uC2A4\uD504\uB808\uC18C: \uBC84\uD2BC\uC744
    \uAE38\uAC8C \uB20C\uB7EC \uCD94\uCD9C (1~1.8\uCD08 \uCD5C\uC801)\n- \uBC00\uD06C:
    \uD53C\uCC98\uB97C \uB204\uB978 \uCC44 \uBD80\uC5B4 \uAC8C\uC774\uC9C0 \uC870\uC808\n-
    \uC2DC\uB7FD: \uBCD1\uC744 \uD0ED (\uCD5C\uB300 3\uD68C)\n- \uD1A0\uD551: '\uD1A0\uD551'
    \uCF20 \uB4A4 \uCEF5\uC744 \uD0ED\n- '\uC644\uC131' \uD6C4 \uCEF5\uC744 \uC190\uB2D8
    \uCE74\uB4DC\uB85C \uB4DC\uB798\uADF8\uD574 \uC11C\uBE59\n\n<b>\u25B6 \uC8FC\uBB38
    \uC554\uD638 \uC608\uC2DC</b>\n- \"\uADF8\uB0E5 \uCEE4\uD53C\" > \uC544\uBA54\uB9AC\uCE74\uB178\n-
    \"\uC6B0\uC720 \uB9CE\uC774\" > \uB77C\uB5BC\n- \"\uB2EC\uB2EC\uD558\uAC8C /
    \uCD08\uCF54\" > \uC2DC\uB7FD \uB4EC\uBFCD (\uBAA8\uCE74)\n- \"\uBA38\uB9AC \uC704\uC5D0
    \uAD6C\uB984\" > \uD718\uD551 \uD1A0\uD551\n- \"\uD751\uB2F9 \uB4EC\uBFCD\" >
    \uC2DC\uB7FD 3\uD68C\n- \"\uD06C\uB9BC \uC62C\uB9B0 \uCEE4\uD53C\" > \uC544\uC778\uC288\uD398\uB108
    (\uC6B0\uC720 \uC5C6\uC774 \uD718\uD551)\n\n<b>\u25B6 \uD301</b>\n- \uC778\uB0B4\uC2EC
    \uBC14\uAC00 \uBE68\uAC1C\uC9C0\uAE30 \uC804\uC5D0 \uC11C\uBE59 (\uC794\uC5EC\uB7C9\uC774
    \uC218\uB839\uC561 \xB135%)\n- \uACE0\uAE09(Lv2) \uC7AC\uB8CC\uB294 \uC870\uC791
    \uD5C8\uC6A9 \uC624\uCC28 \uBCF4\uB108\uC2A4\n- \uB0A8\uC740 \uC7AC\uB8CC/\uC4F0\uB808\uAE30\uB294
    \uD3D0\uAE30 \uBE44\uC6A9 \uBC1C\uC0DD"
